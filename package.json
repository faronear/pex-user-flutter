{
  "name": "pex-user-flutter",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "syncAgentRule": "node -e \"fetch('https://git.tic.cc/opx/sysconfig/raw/branch/main/agents/syncAgentRule.mjs').then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.text()}).then(async t=>{await import('data:text/javascript;base64,'+Buffer.from(t).toString('base64'))})\"",
    "analyze": "flutter analyze",
    "app-webserver-run-local": "if [[ $APP == 'agidin' ]]; then PORT='8081'; else PORT='8082'; fi; flutter run -d web-server --web-port=$PORT -t lib/main_${APP:-agidin}.dart --dart-define=API_BASE=http://localhost:7739",
    "app-webapp-run-local": "CHROME_EXECUTABLE='/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge' flutter run -d chrome -t lib/main_${APP:-agidin}.dart --dart-define=API_BASE=http://localhost:7739",
    "app-macos-run-local": "flutter run -d macos -t lib/main_${APP:-agidin}.dart --dart-define=API_BASE=http://localhost:7739",
    "serve:web": "cd build/web && python3 -m http.server 8090",
    "check:base": "dart run tool/check_first_touch.dart",
    "app-web-build-local": "flutter build web --release -t lib/main_${APP:-agidin}.dart --dart-define=API_BASE=http://localhost:7739",
    "app-web-build-prod": "flutter build web --release -t lib/main_${APP:-agidin}.dart --dart-define=API_BASE=https://pexserver.tic.cc",
    "app-web-deploy-cf": "wrangler pages deploy build/web --project-name=user-${APP:-agidin}-com",
    "app-apk-build-local": "flutter build apk --flavor ${APP:-agidin} -t lib/main_${APP:-agidin}.dart --dart-define=API_BASE=http://localhost:7739",
    "app-apk-build-prod": "flutter build appbundle --flavor ${APP:-agidin} -t lib/main_${APP:-agidin}.dart --dart-define=API_BASE=https://pexserver.tic.cc",
    "app-ios-build-local": "flutter build ios --flavor ${APP:-agidin} -t lib/main_${APP:-agidin}.dart --dart-define=API_BASE=http://localhost:7739 --simulator",
    "app-ios-build-prod": "flutter build ios --flavor ${APP:-agidin} -t lib/main_${APP:-agidin}.dart --dart-define=API_BASE=https://pexserver.tic.cc",
    "app-ipa-build-prod": "flutter build ipa --flavor ${APP:-agidin} -t lib/main_${APP:-agidin}.dart --dart-define=API_BASE=https://pexserver.tic.cc --export-options-plist=ios/ExportOptions-appstore.plist",
    "app-ios-boot": "bash node_modules/wo_scripts/emuBootIos.sh",
    "app-ios-run-local": "UDID=\"$(bash node_modules/wo_scripts/emuUdidIos.sh \"${EMU:-}\")\"; flutter run -d \"${UDID}\" --flavor ${APP:-agidin} -t lib/main_${APP:-agidin}.dart --dart-define=API_BASE=\"${API_BASE:-http://localhost:7739}\" --pid-file /tmp/pex_flutter_ios_${APP:-agidin}.pid",
    "app-ios-run-local-new": "if [[ $APP == 'agidin' ]]; then BundleID='cc.aizoi.app.dist.ios'; else BundleID='faronear.babely.app.android.dist'; fi; UDID=\"$(bash node_modules/wo_scripts/emuUdidIos.sh \"${EMU:-}\")\"; xcrun simctl uninstall \"${UDID}\" $BundleID; flutter run -d \"${UDID}\" --flavor ${APP:-agidin} -t lib/main_${APP:-agidin}.dart --dart-define=API_BASE=\"${API_BASE:-http://localhost:7739}\" --pid-file /tmp/pex_flutter_ios_${APP:-agidin}.pid"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "config": {
    "emuDefault": "ip16@26.3"
  },
  "devDependencies": {
    "wo_scripts": "git+https://git.tic.cc/opx/wo_scripts"
  }
}
