{
  "name": "pex-user-flutter",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "syncAgentRule": "node -e \"fetch('https://git.tic.cc/opx/sysconfig/raw/branch/main/agents/syncAgentRule.mjs').then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.text()}).then(async t=>{await import('data:text/javascript;base64,'+Buffer.from(t).toString('base64'))})\"",
    "analyze": "flutter analyze",
    "app": "node tool/flutterApp.js",
    "serve:web": "node -e \"require('child_process').spawn('python3',['-m','http.server','8090'],{cwd:'build/web',stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "check:base": "dart run tool/check_first_touch.dart",
    "app-webserver-run": "npm run app -- run-webserver",
    "app-webapp-run": "npm run app -- run-webapp",
    "app-macos-run": "npm run app -- run-macos",
    "app-ios-run": "npm run app -- run-ios",
    "app-ios-run-new": "REINSTALL=1 npm run app -- run-ios",
    "app-ios-boot": "node -e \"require('child_process').spawn('bash',['node_modules/wo_scripts/emuBootIos.sh',...process.argv.slice(1)],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "app-web-build": "npm run app -- build-web",
    "app-apk-build": "npm run app -- build-apk",
    "app-appbundle-build": "npm run app -- build-appbundle",
    "app-ios-build": "npm run app -- build-ios",
    "app-ipa-build": "npm run app -- build-ipa"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "config": {
    "emuDefault": "ip16@26.3"
  },
  "devDependencies": {
    "wo_scripts": "git+https://git.tic.cc/opx/wo_scripts"
  }
}
