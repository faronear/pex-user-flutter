{
  "name": "pex-user-flutter",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "syncAgentRule": "node -e \"fetch('https://git.tic.cc/opx/sysconfig/raw/branch/main/agents/syncAgentRule.mjs').then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.text()}).then(async t=>{await import('data:text/javascript;base64,'+Buffer.from(t).toString('base64'))})\"",
    "analyze": "flutter analyze",
    "app-webserver-run-local": "node -e \"const{spawn}=require('child_process');const app=process.env.APP||'agidin';const port=app==='agidin'?'8081':'8082';spawn('flutter',['run','-d','web-server','--web-port',port,'-t','lib/main_'+app+'.dart','--dart-define','API_BASE='+(process.env.API_BASE||'http://localhost:7739')],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "app-webapp-run-local": "node -e \"const{spawn}=require('child_process'),fs=require('fs');const app=process.env.APP||'agidin';const edge='/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge';const env={...process.env};if(fs.existsSync(edge))env.CHROME_EXECUTABLE=edge;spawn('flutter',['run','-d','chrome','-t','lib/main_'+app+'.dart','--dart-define','API_BASE='+(process.env.API_BASE||'http://localhost:7739')],{stdio:'inherit',env}).on('exit',c=>process.exit(c||0))\"",
    "app-macos-run-local": "node -e \"const{spawn}=require('child_process');const app=process.env.APP||'agidin';spawn('flutter',['run','-d','macos','-t','lib/main_'+app+'.dart','--dart-define','API_BASE='+(process.env.API_BASE||'http://localhost:7739')],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "serve:web": "node -e \"require('child_process').spawn('python3',['-m','http.server','8090'],{cwd:'build/web',stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "check:base": "dart run tool/check_first_touch.dart",
    "app-web-build-local": "node -e \"const{spawn}=require('child_process');const app=process.env.APP||'agidin';spawn('flutter',['build','web','--release','-t','lib/main_'+app+'.dart','--dart-define','API_BASE='+(process.env.API_BASE||'http://localhost:7739')],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "app-web-build-prod": "node -e \"const{spawn}=require('child_process');const app=process.env.APP||'agidin';spawn('flutter',['build','web','--release','-t','lib/main_'+app+'.dart','--dart-define','API_BASE='+(process.env.API_BASE||'https://pexserver.tic.cc')],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "app-web-deploy-cf": "node -e \"const app=process.env.APP||'agidin';require('child_process').spawn('wrangler',['pages','deploy','build/web','--project-name','user-'+app+'-com'],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "app-apk-build-local": "node -e \"const{spawn}=require('child_process');const app=process.env.APP||'agidin';spawn('flutter',['build','apk','--flavor',app,'-t','lib/main_'+app+'.dart','--dart-define','API_BASE='+(process.env.API_BASE||'http://localhost:7739')],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "app-apk-build-prod": "node -e \"const{spawn}=require('child_process');const app=process.env.APP||'agidin';spawn('flutter',['build','appbundle','--flavor',app,'-t','lib/main_'+app+'.dart','--dart-define','API_BASE='+(process.env.API_BASE||'https://pexserver.tic.cc')],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "app-ios-build-local": "node -e \"const{spawn}=require('child_process');const app=process.env.APP||'agidin';spawn('flutter',['build','ios','--flavor',app,'-t','lib/main_'+app+'.dart','--dart-define','API_BASE='+(process.env.API_BASE||'http://localhost:7739'),'--simulator'],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "app-ios-build-prod": "node -e \"const{spawn}=require('child_process');const app=process.env.APP||'agidin';spawn('flutter',['build','ios','--flavor',app,'-t','lib/main_'+app+'.dart','--dart-define','API_BASE='+(process.env.API_BASE||'https://pexserver.tic.cc')],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "app-ipa-build-prod": "node -e \"const{spawn}=require('child_process');const app=process.env.APP||'agidin';spawn('flutter',['build','ipa','--flavor',app,'-t','lib/main_'+app+'.dart','--dart-define','API_BASE='+(process.env.API_BASE||'https://pexserver.tic.cc'),'--export-options-plist','ios/ExportOptions-appstore.plist'],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "app-ios-boot": "node -e \"require('child_process').spawn('bash',['node_modules/wo_scripts/emuBootIos.sh',...process.argv.slice(1)],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "app-ios-run-local": "node -e \"const{spawn,spawnSync}=require('child_process');const app=process.env.APP||'agidin';const u=spawnSync('bash',['node_modules/wo_scripts/emuUdidIos.sh',process.env.EMU||''],{encoding:'utf8'});if(u.status!==0){process.stderr.write(u.stderr||u.stdout||'');process.exit(u.status||1)}spawn('flutter',['run','-d',u.stdout.trim(),'--flavor',app,'-t','lib/main_'+app+'.dart','--dart-define','API_BASE='+(process.env.API_BASE||'http://localhost:7739'),'--pid-file','/tmp/pex_flutter_ios_'+app+'.pid'],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "app-ios-run-local-new": "node -e \"const{spawn,spawnSync}=require('child_process');const app=process.env.APP||'agidin';const bundle=app==='agidin'?'cc.aizoi.app.dist.ios':'faronear.babely.app.ios.dist';const u=spawnSync('bash',['node_modules/wo_scripts/emuUdidIos.sh',process.env.EMU||''],{encoding:'utf8'});if(u.status!==0){process.stderr.write(u.stderr||u.stdout||'');process.exit(u.status||1)}spawnSync('xcrun',['simctl','uninstall',u.stdout.trim(),bundle],{stdio:'inherit'});spawn('flutter',['run','-d',u.stdout.trim(),'--flavor',app,'-t','lib/main_'+app+'.dart','--dart-define','API_BASE='+(process.env.API_BASE||'http://localhost:7739'),'--pid-file','/tmp/pex_flutter_ios_'+app+'.pid'],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "config": {
    "emuDefault": "ip16@26.3"
  },
  "devDependencies": {
    "wo_scripts": "git+https://git.tic.cc/opx/wo_scripts"
  }
}
