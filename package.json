{
  "name": "pex-user-flutter",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "syncAgentRule": "node -e \"fetch('https://git.tic.cc/opx/sysconfig/raw/branch/main/agents/syncAgentRule.mjs').then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.text()}).then(async t=>{await import('data:text/javascript;base64,'+Buffer.from(t).toString('base64'))})\"",
    "analyze": "flutter analyze",
    "dev:web": "flutter run -d web-server --web-port=8090 -t lib/main_agidin.dart --dart-define=API_BASE=http://localhost:7739",
    "run:chrome": "flutter run -d chrome --dart-define=API_BASE=http://localhost:7739",
    "run:macos": "flutter run -d macos -t lib/main_agidin.dart --dart-define=API_BASE=http://localhost:7739",
    "build:web": "npm run build:web:agidin",
    "serve:web": "cd build/web && python3 -m http.server 8090",
    "check:base": "dart run tool/check_first_touch.dart",
    "run:agidin": "flutter run -d chrome -t lib/main_agidin.dart --dart-define=API_BASE=http://localhost:7739",
    "run:babelyx": "flutter run -d chrome -t lib/main_babelyx.dart --dart-define=API_BASE=http://localhost:7739",
    "run:tryapp": "flutter run -d chrome -t lib/main_tryapp.dart --dart-define=API_BASE=http://localhost:7739",
    "build:web:agidin": "flutter build web --release -t lib/main_agidin.dart --dart-define=API_BASE=http://localhost:7739",
    "build:web:babelyx": "flutter build web --release -t lib/main_babelyx.dart --dart-define=API_BASE=http://localhost:7739",
    "build:web:tryapp": "flutter build web --release -t lib/main_tryapp.dart --dart-define=API_BASE=http://localhost:7739",
    "build:web:prod:agidin": "flutter build web --release -t lib/main_agidin.dart --dart-define=API_BASE=https://pexserver.tic.cc",
    "build:web:prod:babelyx": "flutter build web --release -t lib/main_babelyx.dart --dart-define=API_BASE=https://pexserver.tic.cc",
    "build:web:prod:tryapp": "flutter build web --release -t lib/main_tryapp.dart --dart-define=API_BASE=https://pexserver.tic.cc",
    "deploy:web:agidin": "wrangler pages deploy build/web --project-name=user-agidin-com",
    "deploy:web:babelyx": "wrangler pages deploy build/web --project-name=user-babelyx-com",
    "deploy:web:tryapp": "wrangler pages deploy build/web --project-name=tryapp-user",
    "release:web:agidin": "npm run build:web:prod:agidin && npm run deploy:web:agidin",
    "release:web:babelyx": "npm run build:web:prod:babelyx && npm run deploy:web:babelyx",
    "release:web:tryapp": "npm run build:web:prod:tryapp && npm run deploy:web:tryapp",
    "build:android:agidin": "flutter build apk --flavor agidin -t lib/main_agidin.dart --dart-define=API_BASE=http://localhost:7739",
    "build:android:babelyx": "flutter build apk --flavor babelyx -t lib/main_babelyx.dart --dart-define=API_BASE=http://localhost:7739",
    "build:android:tryapp": "flutter build apk --flavor tryapp -t lib/main_tryapp.dart --dart-define=API_BASE=http://localhost:7739",
    "build:android:prod:agidin": "flutter build appbundle --flavor agidin -t lib/main_agidin.dart --dart-define=API_BASE=https://pexserver.tic.cc",
    "build:android:prod:babelyx": "flutter build appbundle --flavor babelyx -t lib/main_babelyx.dart --dart-define=API_BASE=https://pexserver.tic.cc",
    "build:android:prod:tryapp": "flutter build appbundle --flavor tryapp -t lib/main_tryapp.dart --dart-define=API_BASE=https://pexserver.tic.cc",
    "build:ios:agidin": "flutter build ios --flavor agidin -t lib/main_agidin.dart --dart-define=API_BASE=http://localhost:7739 --simulator",
    "build:ios:babelyx": "flutter build ios --flavor babelyx -t lib/main_babelyx.dart --dart-define=API_BASE=http://localhost:7739 --simulator",
    "build:ios:tryapp": "flutter build ios --flavor tryapp -t lib/main_tryapp.dart --dart-define=API_BASE=http://localhost:7739 --simulator",
    "build:ios:prod:agidin": "flutter build ios --flavor agidin -t lib/main_agidin.dart --dart-define=API_BASE=https://pexserver.tic.cc",
    "build:ios:prod:babelyx": "flutter build ios --flavor babelyx -t lib/main_babelyx.dart --dart-define=API_BASE=https://pexserver.tic.cc",
    "build:ios:prod:tryapp": "flutter build ios --flavor tryapp -t lib/main_tryapp.dart --dart-define=API_BASE=https://pexserver.tic.cc"
  },
  "keywords": [],
